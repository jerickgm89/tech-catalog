# Turso (libSQL) — crea una DB con `turso db create tech-catalog`
TURSO_DATABASE_URL=libsql://tu-db-xxxxx.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Credenciales del panel admin (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=cambia-este-secreto-por-uno-aleatorio-largo-y-seguro
