---
import type { Product } from '../data/products';
import { formatPrice } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class:list={[
    'card group flex flex-col',
    !product.disponible && 'opacity-90',
  ]}
  data-product-id={product.id}
  data-product-name={product.name}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-blueRibbon-50">
    <img
      src={product.image}
      alt={`${product.brand} ${product.name}`}
      loading="lazy"
      class:list={[
        'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105',
        !product.disponible && 'grayscale',
      ]}
    />
    <span
      class="absolute left-3 top-3 rounded-full border border-blueRibbon-200 bg-white/95 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-blueRibbon-700 backdrop-blur"
    >
      {product.brand}
    </span>
    {!product.disponible && (
      <span
        class="absolute right-3 top-3 rounded-full border border-slate-300 bg-white/95 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-slate-600 backdrop-blur"
      >
        Agotado
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-4 p-5">
    <header class="flex flex-col gap-1">
      <h2 class="text-xl font-bold text-ink">{product.name}</h2>
      <p class="text-sm text-slate-500">Laptop {product.brand}</p>
    </header>

    <ul class="space-y-1.5 text-sm text-slate-600">
      <li class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span class="font-medium text-slate-500">RAM:</span>
        <span>{product.specs.ram}</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span class="font-medium text-slate-500">Almacenamiento:</span>
        <span>{product.specs.almacenamiento}</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span class="font-medium text-slate-500">Procesador:</span>
        <span>{product.specs.procesador}</span>
      </li>
    </ul>

    <div class="mt-auto flex items-center justify-between gap-3 pt-3">
      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-wider text-slate-500">Precio</span>
        <span class="font-display text-2xl font-bold text-ink">
          {formatPrice(product.price)}
        </span>
      </div>
      {product.disponible ? (
        <button
          type="button"
          class="btn-primary"
          data-open-order={product.name}
          aria-label={`Pedir ${product.name}`}
        >
          Pedir ahora 🛒
        </button>
      ) : (
        <span class="text-sm font-medium text-slate-500">
          😔 Agotado por el momento
        </span>
      )}
    </div>
  </div>
</article>
