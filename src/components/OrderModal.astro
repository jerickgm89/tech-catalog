---
import { products, formatPrice } from '../data/products';

const availableProducts = products.filter((p) => p.disponible);
const WHATSAPP_NUMBER = '51936114196';

const PRODUCTS_JSON = availableProducts.map((p) => ({
  id: p.id,
  name: p.name,
  brand: p.brand,
  price: p.price,
  image: p.image,
}));
---

<button
  type="button"
  id="open-order-modal"
  class="fixed bottom-6 right-6 z-30 flex items-center gap-2 rounded-full bg-accent-gradient px-5 py-4 font-display text-base font-bold text-white shadow-glowStrong transition-all duration-300 hover:scale-105 sm:bottom-8 sm:right-8 sm:text-lg"
  aria-label="Hacer un pedido"
>
  <span>Hacer pedido</span>
  <span class="text-xl">🛒</span>
</button>

<div
  id="order-modal"
  class="modal-backdrop hidden animate-fade-in"
  role="dialog"
  aria-modal="true"
  aria-labelledby="order-modal-title"
>
  <div
    class="relative flex max-h-[92vh] w-full max-w-2xl animate-scale-in flex-col overflow-hidden rounded-2xl border border-blueRibbon-100 bg-white shadow-glowStrong"
  >
    <div class="bg-accent-gradient px-6 py-5 text-white">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-90">
            Nuevo pedido
          </p>
          <h3
            id="order-modal-title"
            class="font-display text-2xl font-bold leading-tight text-white"
          >
            Detalles del pedido 🛒
          </h3>
        </div>
        <button
          type="button"
          id="modal-close"
          aria-label="Cerrar"
          class="rounded-full bg-white/15 p-2 text-white transition hover:bg-white/25"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <form id="order-form" class="flex flex-1 flex-col overflow-hidden" novalidate>
      <div class="flex-1 space-y-5 overflow-y-auto px-6 py-6">
        <div>
          <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h4 class="text-sm font-semibold uppercase tracking-wider text-blueRibbon-700">
                Tu carrito
              </h4>
              <p class="mt-0.5 text-xs text-slate-500">
                Agrega productos y ajusta las cantidades.
              </p>
            </div>
            <div class="relative">
              <select
                id="add-product-select"
                class="w-full appearance-none rounded-xl border border-blueRibbon-200 bg-white py-2.5 pl-4 pr-10 text-sm font-medium text-blueRibbon-700 outline-none transition focus:border-accent sm:w-72"
              >
                <option value="" disabled selected>+ Agregar producto…</option>
              </select>
              <svg
                class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-blueRibbon-700"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>

          <div id="cart-empty" class="rounded-xl border border-dashed border-blueRibbon-200 bg-blueRibbon-50/40 px-4 py-8 text-center">
            <p class="text-3xl">🛒</p>
            <p class="mt-2 text-sm font-medium text-inkSoft">Tu carrito está vacío</p>
            <p class="mt-1 text-xs text-slate-500">
              Usa el selector de arriba para añadir productos.
            </p>
          </div>

          <div id="cart-items" class="hidden space-y-2"></div>

          <div class="mt-3 flex items-center justify-end gap-2 text-sm text-slate-600">
            <span>Total:</span>
            <span id="order-total" class="font-display text-xl font-bold text-ink">S/ 0</span>
          </div>
        </div>

        <div class="border-t border-blueRibbon-100 pt-5">
          <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider text-blueRibbon-700">
            Tus datos
          </h4>
          <div class="space-y-3">
            <div>
              <label for="nombre" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Nombre del cliente <span class="text-accent">*</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                class="input-field"
                placeholder="Ej. Juan Pérez"
                required
                autocomplete="name"
              />
            </div>

            <div>
              <label for="telefono" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Teléfono <span class="text-accent">*</span>
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="input-field"
                placeholder="Ej. 936 114 196"
                required
                autocomplete="tel"
                pattern="[0-9+\s()-]{6,20}"
              />
            </div>

            <div>
              <label for="direccion" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Dirección de entrega <span class="text-accent">*</span>
              </label>
              <textarea
                id="direccion"
                name="direccion"
                rows="2"
                class="input-field resize-none"
                placeholder="Av. Principal 123, distrito, ciudad"
                required></textarea>
            </div>

            <div>
              <label for="notas" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Notas adicionales
                <span class="text-xs font-normal text-slate-500">(opcional)</span>
              </label>
              <textarea
                id="notas"
                name="notas"
                rows="2"
                class="input-field resize-none"
                placeholder='Ej. "entregar después de las 6pm", "sin envoltura"…'
              ></textarea>
            </div>
          </div>
        </div>

        <div
          id="form-error"
          class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
        ></div>

        <div
          id="form-success"
          class="hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"
        ></div>
      </div>

      <div class="flex flex-col-reverse gap-2 border-t border-blueRibbon-100 bg-blueRibbon-50/40 px-6 py-4 sm:flex-row sm:justify-end">
        <button type="button" id="modal-cancel" class="btn-secondary">
          Cancelar
        </button>
        <button type="submit" id="submit-btn" class="btn-primary" disabled>
          <span id="submit-label">Enviar pedido y abrir WhatsApp</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ WHATSAPP_NUMBER, PRODUCTS: PRODUCTS_JSON }}>
  const modal = document.getElementById('order-modal');
  const openBtn = document.getElementById('open-order-modal');
  const form = document.getElementById('order-form');
  const errorBox = document.getElementById('form-error');
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = document.getElementById('submit-label');
  const closeBtn = document.getElementById('modal-close');
  const cancelBtn = document.getElementById('modal-cancel');
  const totalEl = document.getElementById('order-total');
  const cartContainer = document.getElementById('cart-items');
  const cartEmpty = document.getElementById('cart-empty');
  const addSelect = document.getElementById('add-product-select');

  const productsById = new Map();
  for (const p of PRODUCTS) productsById.set(p.id, p);

  /** @type {Map<number, number>} productId -> cantidad */
  const cart = new Map();

  const formatPrice = (n) =>
    `S/ ${Number(n).toLocaleString('es-PE')}`;

  const escapeHtml = (str) =>
    String(str).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[c]));

  const recalcTotal = () => {
    let total = 0;
    for (const [id, qty] of cart) {
      const p = productsById.get(id);
      if (p) total += p.price * qty;
    }
    if (totalEl) totalEl.textContent = formatPrice(total);
  };

  const renderDropdown = () => {
    if (!(addSelect instanceof HTMLSelectElement)) return;
    addSelect.innerHTML = '';

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.disabled = true;
    placeholder.selected = true;
    placeholder.textContent =
      cart.size >= PRODUCTS.length
        ? 'Ya agregaste todos los productos'
        : '+ Agregar producto…';
    addSelect.appendChild(placeholder);

    for (const p of PRODUCTS) {
      if (cart.has(p.id)) continue;
      const opt = document.createElement('option');
      opt.value = String(p.id);
      opt.textContent = `${p.name} — ${formatPrice(p.price)}`;
      addSelect.appendChild(opt);
    }

    addSelect.disabled = cart.size >= PRODUCTS.length;
  };

  const renderCart = () => {
    if (!cartContainer || !cartEmpty) return;

    if (cart.size === 0) {
      cartContainer.classList.add('hidden');
      cartContainer.innerHTML = '';
      cartEmpty.classList.remove('hidden');
    } else {
      cartEmpty.classList.add('hidden');
      cartContainer.classList.remove('hidden');
      cartContainer.innerHTML = '';

      for (const [id, cantidad] of cart) {
        const p = productsById.get(id);
        if (!p) continue;
        const subtotal = p.price * cantidad;

        const item = document.createElement('div');
        item.className =
          'flex items-center gap-3 rounded-xl border border-blueRibbon-100 bg-blueRibbon-50/40 p-3';
        item.dataset.productId = String(id);
        item.innerHTML = `
          <img
            src="${escapeHtml(p.image)}"
            alt="${escapeHtml(p.name)}"
            class="h-14 w-14 flex-shrink-0 rounded-lg border border-blueRibbon-100 bg-white object-cover sm:h-16 sm:w-16"
            loading="lazy"
          />
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-ink sm:text-base">${escapeHtml(p.name)}</p>
            <p class="text-xs text-slate-500">${escapeHtml(p.brand)} · ${formatPrice(p.price)} c/u</p>
            <p class="mt-0.5 text-xs"><span class="text-slate-500">Subtotal: </span><span class="font-semibold text-blueRibbon-700">${formatPrice(subtotal)}</span></p>
          </div>
          <div class="flex flex-col items-end gap-1.5">
            <button
              type="button"
              class="remove-item rounded-full p-1 text-slate-400 transition hover:bg-red-50 hover:text-red-600"
              aria-label="Quitar ${escapeHtml(p.name)}"
              title="Quitar"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
            <div class="flex items-center gap-1">
              <button
                type="button"
                class="qty-dec grid h-8 w-8 place-items-center rounded-lg border border-blueRibbon-200 bg-white text-lg font-bold text-blueRibbon-700 transition hover:border-accent hover:bg-blueRibbon-50"
                aria-label="Disminuir"
              >−</button>
              <input
                type="number"
                class="qty-input h-8 w-12 rounded-lg border border-blueRibbon-200 bg-white text-center text-sm font-semibold text-ink outline-none transition focus:border-accent"
                min="1"
                max="99"
                value="${cantidad}"
              />
              <button
                type="button"
                class="qty-inc grid h-8 w-8 place-items-center rounded-lg border border-blueRibbon-200 bg-white text-lg font-bold text-blueRibbon-700 transition hover:border-accent hover:bg-blueRibbon-50"
                aria-label="Aumentar"
              >+</button>
            </div>
          </div>
        `;
        cartContainer.appendChild(item);
      }
    }

    recalcTotal();
    renderDropdown();
    validateForm();
  };

  const setQuantity = (id, qty) => {
    if (qty <= 0) {
      cart.delete(id);
    } else {
      cart.set(id, Math.min(99, qty));
    }
    renderCart();
  };

  const addToCart = (id) => {
    if (!productsById.has(id)) return;
    cart.set(id, (cart.get(id) || 0) + 1);
    renderCart();
  };

  const clearCart = () => {
    cart.clear();
    renderCart();
  };

  const validateForm = () => {
    if (!(form instanceof HTMLFormElement)) return;
    const nombre = form.nombre.value.trim();
    const telefono = form.telefono.value.trim();
    const direccion = form.direccion.value.trim();

    const valid =
      cart.size > 0 &&
      nombre.length > 0 &&
      /^[0-9+\s()-]{6,20}$/.test(telefono) &&
      direccion.length > 0;

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = !valid;
    }
  };

  const openModal = (productName) => {
    if (!modal) return;
    clearCart();
    if (productName) {
      const p = PRODUCTS.find((x) => x.name === productName);
      if (p) addToCart(p.id);
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    errorBox?.classList.add('hidden');
    successBox?.classList.add('hidden');
    setTimeout(() => {
      const firstField = form?.querySelector('#nombre');
      if (firstField instanceof HTMLElement) firstField.focus();
    }, 50);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  };

  const resetForm = () => {
    if (form instanceof HTMLFormElement) form.reset();
    clearCart();
  };

  openBtn?.addEventListener('click', () => openModal());

  addSelect?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLSelectElement)) return;
    const id = Number(target.value);
    if (id) {
      addToCart(id);
      target.value = '';
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const openOrderBtn = target.closest('[data-open-order]');
    if (openOrderBtn instanceof HTMLElement) {
      openModal(openOrderBtn.dataset.openOrder || undefined);
      return;
    }

    if (!cartContainer?.contains(target)) return;
    const cartItem = target.closest('[data-product-id]');
    if (!(cartItem instanceof HTMLElement)) return;
    const id = Number(cartItem.dataset.productId);
    if (!id) return;

    if (target.closest('.remove-item')) {
      cart.delete(id);
      renderCart();
      return;
    }
    if (target.closest('.qty-inc')) {
      setQuantity(id, (cart.get(id) || 0) + 1);
      return;
    }
    if (target.closest('.qty-dec')) {
      setQuantity(id, (cart.get(id) || 0) - 1);
      return;
    }
  });

  cartContainer?.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (!target.classList.contains('qty-input')) return;
    const cartItem = target.closest('[data-product-id]');
    if (!(cartItem instanceof HTMLElement)) return;
    const id = Number(cartItem.dataset.productId);
    if (!id) return;
    const raw = Math.floor(Number(target.value) || 0);
    const qty = Math.max(0, Math.min(99, raw));
    if (qty === 0) {
      cart.delete(id);
    } else {
      cart.set(id, qty);
    }
    recalcTotal();
    validateForm();
  });

  cartContainer?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (!target.classList.contains('qty-input')) return;
    renderCart();
  });

  form?.addEventListener('input', (event) => {
    const target = event.target;
    if (
      target instanceof HTMLInputElement &&
      target.classList.contains('qty-input')
    ) {
      return;
    }
    validateForm();
  });

  closeBtn?.addEventListener('click', () => {
    closeModal();
    resetForm();
  });
  cancelBtn?.addEventListener('click', () => {
    closeModal();
    resetForm();
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
      resetForm();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
      resetForm();
    }
  });

  const showError = (message) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
    successBox?.classList.add('hidden');
  };

  const showSuccess = (message) => {
    if (!successBox) return;
    successBox.textContent = message;
    successBox.classList.remove('hidden');
    errorBox?.classList.add('hidden');
  };

  const collectItems = () => {
    const items = [];
    for (const [id, cantidad] of cart) {
      const p = productsById.get(id);
      if (!p || cantidad < 1) continue;
      items.push({
        producto: p.name,
        cantidad,
        precio: p.price,
      });
    }
    return items;
  };

  const buildWhatsappMessage = (data, items, total) => {
    const lines = ['Hola, quiero pedir:', ''];
    lines.push('*Productos:*');
    for (const it of items) {
      lines.push(`- ${it.producto} x${it.cantidad} (${formatPrice(it.precio * it.cantidad)})`);
    }
    lines.push('');
    lines.push(`*Total:* ${formatPrice(total)}`);
    lines.push('');
    lines.push(`*Nombre:* ${data.nombre}`);
    lines.push(`*Teléfono:* ${data.telefono}`);
    lines.push(`*Dirección:* ${data.direccion}`);
    if (data.notas) lines.push(`*Notas:* ${data.notas}`);
    return lines.join('\n');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const data = {
      nombre: form.nombre.value.trim(),
      telefono: form.telefono.value.trim(),
      direccion: form.direccion.value.trim(),
      notas: form.notas.value.trim(),
    };

    const items = collectItems();

    if (items.length === 0) {
      showError('Agrega al menos un producto al carrito.');
      return;
    }
    if (!data.nombre || !data.telefono || !data.direccion) {
      showError('Completa nombre, teléfono y dirección.');
      return;
    }
    if (!/^[0-9+\s()-]{6,20}$/.test(data.telefono)) {
      showError('Ingresa un teléfono válido.');
      return;
    }

    errorBox?.classList.add('hidden');
    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Enviando...';

    try {
      const response = await fetch('/api/pedidos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...data,
          items: items.map((i) => ({ producto: i.producto, cantidad: i.cantidad })),
        }),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'No se pudo registrar el pedido');
      }

      const total = items.reduce((s, i) => s + i.precio * i.cantidad, 0);
      const message = buildWhatsappMessage(data, items, total);
      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');

      showSuccess(`¡Listo! Pedido N° ${result.pedidoId} registrado. Abrimos WhatsApp para que confirmes.`);
      setTimeout(() => {
        closeModal();
        resetForm();
      }, 1800);
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Ocurrió un error inesperado.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Enviar pedido y abrir WhatsApp';
    }
  });

  renderCart();
</script>
