---
import { products, formatPrice } from '../data/products';

const availableProducts = products.filter((p) => p.disponible);
const WHATSAPP_NUMBER = '51936114196';
---

<button
  type="button"
  id="open-order-modal"
  class="fixed bottom-6 right-6 z-30 flex items-center gap-2 rounded-full bg-accent-gradient px-5 py-4 font-display text-base font-bold text-white shadow-glowStrong transition-all duration-300 hover:scale-105 sm:bottom-8 sm:right-8 sm:text-lg"
  aria-label="Hacer un pedido"
>
  <span>Hacer pedido</span>
  <span class="text-xl">🛒</span>
</button>

<div
  id="order-modal"
  class="modal-backdrop hidden animate-fade-in"
  role="dialog"
  aria-modal="true"
  aria-labelledby="order-modal-title"
>
  <div
    class="relative flex max-h-[92vh] w-full max-w-2xl animate-scale-in flex-col overflow-hidden rounded-2xl border border-blueRibbon-100 bg-white shadow-glowStrong"
  >
    <div class="bg-accent-gradient px-6 py-5 text-white">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-90">
            Nuevo pedido
          </p>
          <h3
            id="order-modal-title"
            class="font-display text-2xl font-bold leading-tight text-white"
          >
            Detalles del pedido 🛒
          </h3>
        </div>
        <button
          type="button"
          id="modal-close"
          aria-label="Cerrar"
          class="rounded-full bg-white/15 p-2 text-white transition hover:bg-white/25"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <form id="order-form" class="flex flex-1 flex-col overflow-hidden" novalidate>
      <div class="flex-1 space-y-5 overflow-y-auto px-6 py-6">
        <div>
          <h4 class="mb-2 text-sm font-semibold uppercase tracking-wider text-blueRibbon-700">
            Productos
          </h4>
          <p class="mb-3 text-xs text-slate-500">
            Indica la cantidad que deseas para cada producto.
          </p>
          <ul class="space-y-2">
            {availableProducts.map((p) => (
              <li
                class="flex items-center justify-between gap-3 rounded-xl border border-blueRibbon-100 bg-blueRibbon-50/60 px-4 py-3"
                data-product-id={p.id}
              >
                <div class="min-w-0 flex-1">
                  <p class="truncate font-medium text-ink">{p.name}</p>
                  <p class="text-xs text-slate-500">{formatPrice(p.price)}</p>
                </div>
                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    class="qty-dec grid h-8 w-8 place-items-center rounded-lg border border-blueRibbon-200 bg-white text-lg font-bold text-blueRibbon-700 transition hover:border-accent hover:bg-blueRibbon-50"
                    aria-label={`Disminuir cantidad de ${p.name}`}
                  >−</button>
                  <input
                    type="number"
                    name={`qty-${p.id}`}
                    class="qty-input h-8 w-14 rounded-lg border border-blueRibbon-200 bg-white text-center text-sm font-semibold text-ink outline-none transition focus:border-accent"
                    min="0"
                    max="99"
                    value="0"
                    data-product-name={p.name}
                    data-product-price={p.price}
                  />
                  <button
                    type="button"
                    class="qty-inc grid h-8 w-8 place-items-center rounded-lg border border-blueRibbon-200 bg-white text-lg font-bold text-blueRibbon-700 transition hover:border-accent hover:bg-blueRibbon-50"
                    aria-label={`Aumentar cantidad de ${p.name}`}
                  >+</button>
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-right text-sm text-slate-600">
            Total: <span id="order-total" class="font-display text-lg font-bold text-ink">S/ 0</span>
          </p>
        </div>

        <div class="border-t border-blueRibbon-100 pt-5">
          <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider text-blueRibbon-700">
            Tus datos
          </h4>
          <div class="space-y-3">
            <div>
              <label for="nombre" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Nombre del cliente <span class="text-accent">*</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                class="input-field"
                placeholder="Ej. Juan Pérez"
                required
                autocomplete="name"
              />
            </div>

            <div>
              <label for="telefono" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Teléfono <span class="text-accent">*</span>
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="input-field"
                placeholder="Ej. 936 114 196"
                required
                autocomplete="tel"
                pattern="[0-9+\s()-]{6,20}"
              />
            </div>

            <div>
              <label for="direccion" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Dirección de entrega <span class="text-accent">*</span>
              </label>
              <textarea
                id="direccion"
                name="direccion"
                rows="2"
                class="input-field resize-none"
                placeholder="Av. Principal 123, distrito, ciudad"
                required></textarea>
            </div>

            <div>
              <label for="notas" class="mb-1.5 block text-sm font-medium text-inkSoft">
                Notas adicionales
                <span class="text-xs font-normal text-slate-500">(opcional)</span>
              </label>
              <textarea
                id="notas"
                name="notas"
                rows="2"
                class="input-field resize-none"
                placeholder='Ej. "entregar después de las 6pm", "sin envoltura"…'
              ></textarea>
            </div>
          </div>
        </div>

        <div
          id="form-error"
          class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
        ></div>

        <div
          id="form-success"
          class="hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"
        ></div>
      </div>

      <div class="flex flex-col-reverse gap-2 border-t border-blueRibbon-100 bg-blueRibbon-50/40 px-6 py-4 sm:flex-row sm:justify-end">
        <button type="button" id="modal-cancel" class="btn-secondary">
          Cancelar
        </button>
        <button type="submit" id="submit-btn" class="btn-primary" disabled>
          <span id="submit-label">Enviar pedido y abrir WhatsApp</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ WHATSAPP_NUMBER }}>
  const modal = document.getElementById('order-modal');
  const openBtn = document.getElementById('open-order-modal');
  const form = document.getElementById('order-form');
  const errorBox = document.getElementById('form-error');
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = document.getElementById('submit-label');
  const closeBtn = document.getElementById('modal-close');
  const cancelBtn = document.getElementById('modal-cancel');
  const totalEl = document.getElementById('order-total');

  const qtyInputs = () =>
    /** @type {NodeListOf<HTMLInputElement>} */ (
      form?.querySelectorAll('.qty-input')
    );

  const formatPrice = (n) =>
    `S/ ${Number(n).toLocaleString('es-PE')}`;

  const recalcTotal = () => {
    let total = 0;
    qtyInputs()?.forEach((input) => {
      const qty = Number(input.value) || 0;
      const price = Number(input.dataset.productPrice) || 0;
      total += qty * price;
    });
    if (totalEl) totalEl.textContent = formatPrice(total);
    validateForm();
  };

  const validateForm = () => {
    if (!(form instanceof HTMLFormElement)) return;

    let hasItem = false;
    qtyInputs()?.forEach((input) => {
      if ((Number(input.value) || 0) > 0) hasItem = true;
    });

    const nombre = form.nombre.value.trim();
    const telefono = form.telefono.value.trim();
    const direccion = form.direccion.value.trim();

    const valid =
      hasItem &&
      nombre.length > 0 &&
      /^[0-9+\s()-]{6,20}$/.test(telefono) &&
      direccion.length > 0;

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = !valid;
    }
  };

  const resetQuantities = () => {
    qtyInputs()?.forEach((input) => {
      input.value = '0';
    });
    recalcTotal();
  };

  const setQuantity = (productName, qty) => {
    qtyInputs()?.forEach((input) => {
      if (input.dataset.productName === productName) {
        input.value = String(qty);
      }
    });
    recalcTotal();
  };

  const openModal = (productName) => {
    if (!modal) return;
    resetQuantities();
    if (productName) setQuantity(productName, 1);
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    errorBox?.classList.add('hidden');
    successBox?.classList.add('hidden');
    setTimeout(() => {
      const firstField = form?.querySelector('#nombre');
      if (firstField instanceof HTMLElement) firstField.focus();
    }, 50);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  };

  const resetForm = () => {
    if (form instanceof HTMLFormElement) form.reset();
    resetQuantities();
  };

  openBtn?.addEventListener('click', () => openModal());

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const buyBtn = target.closest('[data-open-order]');
    if (buyBtn instanceof HTMLElement) {
      openModal(buyBtn.dataset.openOrder || undefined);
      return;
    }

    if (target.closest('.qty-inc')) {
      const li = target.closest('li[data-product-id]');
      const input = li?.querySelector('.qty-input');
      if (input instanceof HTMLInputElement) {
        const next = Math.min(99, (Number(input.value) || 0) + 1);
        input.value = String(next);
        recalcTotal();
      }
      return;
    }
    if (target.closest('.qty-dec')) {
      const li = target.closest('li[data-product-id]');
      const input = li?.querySelector('.qty-input');
      if (input instanceof HTMLInputElement) {
        const next = Math.max(0, (Number(input.value) || 0) - 1);
        input.value = String(next);
        recalcTotal();
      }
      return;
    }
  });

  form?.addEventListener('input', (event) => {
    if (
      event.target instanceof HTMLInputElement &&
      event.target.classList.contains('qty-input')
    ) {
      const v = Math.max(0, Math.min(99, Math.floor(Number(event.target.value) || 0)));
      event.target.value = String(v);
      recalcTotal();
      return;
    }
    validateForm();
  });

  closeBtn?.addEventListener('click', () => {
    closeModal();
    resetForm();
  });
  cancelBtn?.addEventListener('click', () => {
    closeModal();
    resetForm();
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
      resetForm();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
      resetForm();
    }
  });

  const showError = (message) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
    successBox?.classList.add('hidden');
  };

  const showSuccess = (message) => {
    if (!successBox) return;
    successBox.textContent = message;
    successBox.classList.remove('hidden');
    errorBox?.classList.add('hidden');
  };

  const collectItems = () => {
    const items = [];
    qtyInputs()?.forEach((input) => {
      const qty = Number(input.value) || 0;
      if (qty > 0) {
        items.push({
          producto: input.dataset.productName || '',
          cantidad: qty,
          precio: Number(input.dataset.productPrice) || 0,
        });
      }
    });
    return items;
  };

  const buildWhatsappMessage = (data, items, total) => {
    const lines = ['Hola, quiero pedir:', ''];
    lines.push('*Productos:*');
    for (const it of items) {
      lines.push(`- ${it.producto} x${it.cantidad} (${formatPrice(it.precio * it.cantidad)})`);
    }
    lines.push('');
    lines.push(`*Total:* ${formatPrice(total)}`);
    lines.push('');
    lines.push(`*Nombre:* ${data.nombre}`);
    lines.push(`*Teléfono:* ${data.telefono}`);
    lines.push(`*Dirección:* ${data.direccion}`);
    if (data.notas) lines.push(`*Notas:* ${data.notas}`);
    return lines.join('\n');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const data = {
      nombre: form.nombre.value.trim(),
      telefono: form.telefono.value.trim(),
      direccion: form.direccion.value.trim(),
      notas: form.notas.value.trim(),
    };

    const items = collectItems();

    if (items.length === 0) {
      showError('Selecciona al menos un producto con cantidad mayor a 0.');
      return;
    }
    if (!data.nombre || !data.telefono || !data.direccion) {
      showError('Completa nombre, teléfono y dirección.');
      return;
    }
    if (!/^[0-9+\s()-]{6,20}$/.test(data.telefono)) {
      showError('Ingresa un teléfono válido.');
      return;
    }

    errorBox?.classList.add('hidden');
    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Enviando...';

    try {
      const response = await fetch('/api/pedidos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...data,
          items: items.map((i) => ({ producto: i.producto, cantidad: i.cantidad })),
        }),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'No se pudo registrar el pedido');
      }

      const total = items.reduce((s, i) => s + i.precio * i.cantidad, 0);
      const message = buildWhatsappMessage(data, items, total);
      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');

      showSuccess(`¡Listo! Pedido N° ${result.pedidoId} registrado. Abrimos WhatsApp para que confirmes.`);
      setTimeout(() => {
        closeModal();
        resetForm();
      }, 1800);
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Ocurrió un error inesperado.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Enviar pedido y abrir WhatsApp';
    }
  });
</script>
