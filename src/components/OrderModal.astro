---
import { products } from '../data/products';

const productNames = products.map((p) => p.name);
---

<button
  type="button"
  id="open-order-modal"
  class="fixed bottom-6 right-6 z-30 flex items-center gap-2 rounded-full bg-accent-gradient px-5 py-4 font-display text-base font-bold text-slate-950 shadow-glowStrong transition-all duration-300 hover:scale-105 sm:bottom-8 sm:right-8 sm:text-lg"
  aria-label="Hacer un pedido"
>
  <span>Hacer pedido</span>
  <span class="text-xl">🍰</span>
</button>

<div
  id="order-modal"
  class="modal-backdrop hidden animate-fade-in"
  role="dialog"
  aria-modal="true"
  aria-labelledby="order-modal-title"
>
  <div
    class="relative w-full max-w-lg animate-scale-in overflow-hidden rounded-2xl border border-white/10 bg-surface shadow-glowStrong"
  >
    <div class="bg-accent-gradient px-6 py-5 text-slate-950">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-80">
            Nuevo pedido
          </p>
          <h3
            id="order-modal-title"
            class="font-display text-2xl font-bold leading-tight"
          >
            Cuéntanos los detalles 🍰
          </h3>
        </div>
        <button
          type="button"
          id="modal-close"
          aria-label="Cerrar"
          class="rounded-full bg-black/15 p-2 text-slate-950 transition hover:bg-black/30"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <form id="order-form" class="space-y-4 px-6 py-6" novalidate>
      <div>
        <label for="nombre" class="mb-1.5 block text-sm font-medium text-slate-300">
          Nombre del cliente <span class="text-accent">*</span>
        </label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          class="input-field"
          placeholder="Ej. Juan Pérez"
          required
          autocomplete="name"
        />
      </div>

      <div>
        <label for="telefono" class="mb-1.5 block text-sm font-medium text-slate-300">
          Teléfono <span class="text-accent">*</span>
        </label>
        <input
          type="tel"
          id="telefono"
          name="telefono"
          class="input-field"
          placeholder="Ej. 999 999 999"
          required
          autocomplete="tel"
          pattern="[0-9+\s()-]{6,20}"
        />
      </div>

      <div>
        <label for="direccion" class="mb-1.5 block text-sm font-medium text-slate-300">
          Dirección de entrega <span class="text-accent">*</span>
        </label>
        <textarea
          id="direccion"
          name="direccion"
          rows="2"
          class="input-field resize-none"
          placeholder="Av. Principal 123, distrito, ciudad"
          required></textarea>
      </div>

      <div>
        <label for="producto" class="mb-1.5 block text-sm font-medium text-slate-300">
          ¿Qué producto quieres? <span class="text-accent">*</span>
        </label>
        <select id="producto" name="producto" class="input-field" required>
          <option value="" disabled selected>Selecciona un producto…</option>
          {productNames.map((name) => <option value={name}>{name}</option>)}
        </select>
      </div>

      <div>
        <label for="notas" class="mb-1.5 block text-sm font-medium text-slate-300">
          Notas adicionales
          <span class="text-xs font-normal text-slate-500">(opcional)</span>
        </label>
        <textarea
          id="notas"
          name="notas"
          rows="3"
          class="input-field resize-none"
          placeholder='Ej. "sin azúcar", "con dedicatoria", entregar después de las 6pm…'
        ></textarea>
      </div>

      <div
        id="form-error"
        class="hidden rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300"
      ></div>

      <div
        id="form-success"
        class="hidden rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300"
      ></div>

      <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">
        <button type="button" id="modal-cancel" class="btn-secondary">
          Cancelar
        </button>
        <button type="submit" id="submit-btn" class="btn-primary">
          <span id="submit-label">Enviar pedido</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  const modal = document.getElementById('order-modal');
  const openBtn = document.getElementById('open-order-modal');
  const form = document.getElementById('order-form');
  const errorBox = document.getElementById('form-error');
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = document.getElementById('submit-label');
  const closeBtn = document.getElementById('modal-close');
  const cancelBtn = document.getElementById('modal-cancel');

  const openModal = () => {
    if (!modal) return;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    errorBox?.classList.add('hidden');
    successBox?.classList.add('hidden');
    setTimeout(() => {
      const firstInput = form?.querySelector('input,select,textarea');
      if (firstInput instanceof HTMLElement) firstInput.focus();
    }, 50);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  };

  const resetForm = () => {
    if (form instanceof HTMLFormElement) form.reset();
  };

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', () => {
    closeModal();
    resetForm();
  });
  cancelBtn?.addEventListener('click', () => {
    closeModal();
    resetForm();
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
      resetForm();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
      resetForm();
    }
  });

  const showError = (message) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
    successBox?.classList.add('hidden');
  };

  const showSuccess = (message) => {
    if (!successBox) return;
    successBox.textContent = message;
    successBox.classList.remove('hidden');
    errorBox?.classList.add('hidden');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const data = {
      nombre: form.nombre.value.trim(),
      telefono: form.telefono.value.trim(),
      direccion: form.direccion.value.trim(),
      producto: form.producto.value.trim(),
      notas: form.notas.value.trim(),
    };

    if (!data.nombre || !data.telefono || !data.direccion || !data.producto) {
      showError('Por favor completa nombre, teléfono, dirección y producto.');
      return;
    }

    if (!/^[0-9+\s()-]{6,20}$/.test(data.telefono)) {
      showError('Ingresa un teléfono válido.');
      return;
    }

    errorBox?.classList.add('hidden');
    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Enviando...';

    try {
      const response = await fetch('/api/pedidos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'No se pudo registrar el pedido');
      }

      showSuccess(`¡Listo! Tu pedido fue registrado (N° ${result.pedidoId}).`);
      resetForm();
      setTimeout(() => {
        closeModal();
      }, 1800);
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Ocurrió un error inesperado.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Enviar pedido';
    }
  });
</script>
