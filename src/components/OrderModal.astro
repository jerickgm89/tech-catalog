---
const WHATSAPP_NUMBER = '51936114196';
---

<div
  id="order-modal"
  class="modal-backdrop hidden animate-fade-in"
  role="dialog"
  aria-modal="true"
  aria-labelledby="order-modal-title"
>
  <div
    class="relative w-full max-w-lg animate-scale-in overflow-hidden rounded-2xl border border-white/10 bg-surface shadow-glowStrong"
  >
    <div class="bg-accent-gradient px-6 py-5 text-slate-950">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-80">
            Confirmar pedido
          </p>
          <h3
            id="order-modal-title"
            class="font-display text-2xl font-bold leading-tight"
          >
            <span id="order-product-name">Producto</span>
          </h3>
        </div>
        <button
          type="button"
          id="modal-close"
          aria-label="Cerrar"
          class="rounded-full bg-black/15 p-2 text-slate-950 transition hover:bg-black/30"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <form id="order-form" class="space-y-4 px-6 py-6" novalidate>
      <input type="hidden" name="producto" id="order-producto" />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="nombres" class="mb-1.5 block text-sm font-medium text-slate-300">
            Nombres <span class="text-accent">*</span>
          </label>
          <input
            type="text"
            id="nombres"
            name="nombres"
            class="input-field"
            placeholder="Ej. Juan Carlos"
            required
            autocomplete="given-name"
          />
        </div>
        <div>
          <label for="apellidos" class="mb-1.5 block text-sm font-medium text-slate-300">
            Apellidos <span class="text-accent">*</span>
          </label>
          <input
            type="text"
            id="apellidos"
            name="apellidos"
            class="input-field"
            placeholder="Ej. Pérez Quispe"
            required
            autocomplete="family-name"
          />
        </div>
      </div>

      <div>
        <label for="dni" class="mb-1.5 block text-sm font-medium text-slate-300">
          DNI <span class="text-accent">*</span>
        </label>
        <input
          type="text"
          id="dni"
          name="dni"
          inputmode="numeric"
          pattern="\d{8}"
          maxlength="8"
          minlength="8"
          class="input-field"
          placeholder="8 dígitos"
          required
        />
        <p class="mt-1 text-xs text-slate-500">Debe contener exactamente 8 dígitos numéricos.</p>
      </div>

      <div>
        <label for="direccion" class="mb-1.5 block text-sm font-medium text-slate-300">
          Dirección de entrega <span class="text-accent">*</span>
        </label>
        <textarea
          id="direccion"
          name="direccion"
          rows="2"
          class="input-field resize-none"
          placeholder="Av. Principal 123, distrito, ciudad"
          required></textarea>
      </div>

      <div
        id="form-error"
        class="hidden rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300"
      ></div>

      <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">
        <button type="button" id="modal-cancel" class="btn-secondary">
          Cancelar
        </button>
        <button type="submit" id="submit-btn" class="btn-primary">
          <span id="submit-label">Confirmar pedido</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ WHATSAPP_NUMBER }}>
  const modal = document.getElementById('order-modal');
  const form = document.getElementById('order-form');
  const productNameEl = document.getElementById('order-product-name');
  const productInput = document.getElementById('order-producto');
  const errorBox = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = document.getElementById('submit-label');
  const closeBtn = document.getElementById('modal-close');
  const cancelBtn = document.getElementById('modal-cancel');

  const openModal = (productName) => {
    if (!modal || !productNameEl || !productInput) return;
    productNameEl.textContent = productName;
    productInput.value = productName;
    if (errorBox) {
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    const firstInput = form?.querySelector('input:not([type="hidden"])');
    if (firstInput instanceof HTMLElement) {
      setTimeout(() => firstInput.focus(), 50);
    }
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    form?.reset();
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const buyButton = target.closest('.buy-button');
    if (buyButton instanceof HTMLElement) {
      const name = buyButton.dataset.productName;
      if (name) openModal(name);
    }
  });

  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  const showError = (message) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const data = {
      nombres: form.nombres.value.trim(),
      apellidos: form.apellidos.value.trim(),
      dni: form.dni.value.trim(),
      direccion: form.direccion.value.trim(),
      producto: form.producto.value.trim(),
    };

    if (!data.nombres || !data.apellidos || !data.dni || !data.direccion) {
      showError('Por favor completa todos los campos.');
      return;
    }

    if (!/^\d{8}$/.test(data.dni)) {
      showError('El DNI debe contener exactamente 8 dígitos.');
      return;
    }

    errorBox?.classList.add('hidden');
    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Procesando...';

    try {
      const response = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'No se pudo registrar el pedido');
      }

      const message = `Hola! Quiero coordinar mi pedido de ${data.producto} - Nombre: ${data.nombres} ${data.apellidos}`;
      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
      closeModal();
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Ocurrió un error inesperado.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Confirmar pedido';
    }
  });
</script>
