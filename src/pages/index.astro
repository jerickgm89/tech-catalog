---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import OrderModal from '../components/OrderModal.astro';
import { products } from '../data/products';
---

<Layout>
  <header class="border-b border-white/5 bg-background/80 backdrop-blur sticky top-0 z-30">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-3">
        <div
          class="grid h-10 w-10 place-items-center rounded-xl bg-accent-gradient text-slate-950 shadow-glow"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="13" rx="2"></rect>
            <path d="M1 20h22"></path>
          </svg>
        </div>
        <div class="flex flex-col leading-tight">
          <span class="font-display text-xl font-bold text-white">TechCatalog</span>
          <span class="text-xs text-slate-400">Laptops con entrega a todo el Perú</span>
        </div>
      </a>

      <nav class="flex items-center gap-4 text-sm text-slate-300 sm:gap-6">
        <a href="#productos" class="hidden transition hover:text-accent md:inline">Productos</a>
        <a href="#contacto" class="hidden transition hover:text-accent md:inline">Contacto</a>
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent/10 px-3 py-1.5 font-medium text-accent transition hover:bg-accent/20"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2 4 5v6c0 5.5 3.5 10.7 8 11 4.5-.3 8-5.5 8-11V5l-8-3z"></path>
          </svg>
          Admin
        </a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 pb-24 pt-12 sm:px-6 lg:px-8">
    <section class="relative mb-14 overflow-hidden rounded-3xl border border-white/5 bg-surface p-8 sm:p-12">
      <div
        class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-accent/20 blur-3xl"
      ></div>
      <div class="relative max-w-2xl">
        <p
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-accent"
        >
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
          Stock disponible
        </p>
        <h1 class="mb-4 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
          Laptops potentes para cada presupuesto
        </h1>
        <p class="text-base text-slate-300 sm:text-lg">
          Encuentra la laptop ideal para estudiar, trabajar o crear. Coordinamos
          tu pedido por WhatsApp y te lo entregamos donde estés.
        </p>
      </div>
    </section>

    <section id="productos" class="scroll-mt-24">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl font-bold text-white">Catálogo</h2>
          <p class="mt-1 text-sm text-slate-400">
            {products.length} laptops seleccionadas para ti
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
  </main>

  <footer id="contacto" class="border-t border-white/5 bg-surface/50">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p class="text-sm text-slate-400">
        © {new Date().getFullYear()} TechCatalog. Todos los derechos reservados.
        <a href="/admin" class="ml-2 text-slate-500 underline-offset-4 hover:text-accent hover:underline">Admin</a>
      </p>
      <a
        href="https://wa.me/51999999999"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.768.967-.941 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.001 2C6.477 2 2 6.477 2 12c0 1.872.514 3.625 1.41 5.13L2.05 22l5.005-1.314A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10s-4.477-10-10-10z"
          ></path>
        </svg>
        +51 999 999 999
      </a>
    </div>
  </footer>

  <OrderModal />
</Layout>
