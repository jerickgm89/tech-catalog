---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';
import { listPedidos, type Pedido } from '../../lib/db';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/login');
}

let pedidos: Pedido[] = [];
let loadError: string | null = null;

try {
  pedidos = await listPedidos();
} catch (err) {
  loadError = err instanceof Error ? err.message : 'No se pudieron cargar los pedidos.';
}

const formatDate = (iso: string): string => {
  const date = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
  if (Number.isNaN(date.getTime())) return iso;
  return new Intl.DateTimeFormat('es-PE', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'America/Lima',
  }).format(date);
};
---

<Layout title="Admin · Pedidos">
  <header class="border-b border-white/5 bg-background/80 backdrop-blur sticky top-0 z-30">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3">
        <a href="/" class="text-sm text-slate-400 transition hover:text-accent">
          ← Volver al catálogo
        </a>
        <span class="hidden text-slate-600 sm:inline">·</span>
        <h1 class="hidden font-display text-xl font-bold text-white sm:block">
          Pedidos
        </h1>
      </div>
      <div class="flex items-center gap-3">
        <span class="hidden text-xs text-slate-400 sm:inline">
          Sesión: <strong class="text-slate-200">{session.u}</strong>
        </span>
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="btn-secondary px-4 py-2 text-sm">
            Cerrar sesión
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-bold text-white">Pedidos recibidos</h2>
        <p class="mt-1 text-sm text-slate-400">
          {pedidos.length} {pedidos.length === 1 ? 'pedido' : 'pedidos'} en la base de datos
        </p>
      </div>
    </div>

    {loadError && (
      <div class="mb-6 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300">
        {loadError}
      </div>
    )}

    {pedidos.length === 0 && !loadError ? (
      <div class="rounded-2xl border border-dashed border-white/10 bg-surface/50 py-16 text-center">
        <p class="text-3xl">📭</p>
        <p class="mt-3 text-slate-300">Aún no hay pedidos registrados.</p>
        <p class="mt-1 text-sm text-slate-500">
          Cuando los clientes envíen el formulario, aparecerán aquí.
        </p>
      </div>
    ) : (
      <div class="overflow-hidden rounded-2xl border border-white/10 bg-surface">
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="bg-surfaceAlt/60 text-xs uppercase tracking-wider text-slate-400">
              <tr>
                <th class="px-4 py-3">#</th>
                <th class="px-4 py-3">Fecha</th>
                <th class="px-4 py-3">Cliente</th>
                <th class="px-4 py-3">Teléfono</th>
                <th class="px-4 py-3">Dirección</th>
                <th class="px-4 py-3">Producto(s)</th>
                <th class="px-4 py-3 text-center">Cant.</th>
                <th class="px-4 py-3">Notas</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {pedidos.map((p) => (
                <tr class="text-slate-200 transition hover:bg-white/5">
                  <td class="px-4 py-3 font-mono text-xs text-slate-400">
                    {p.id}
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 text-slate-300">
                    {formatDate(p.created_at)}
                  </td>
                  <td class="px-4 py-3 font-medium text-white">{p.nombre}</td>
                  <td class="whitespace-nowrap px-4 py-3">
                    <a
                      href={`tel:${p.telefono.replace(/\s+/g, '')}`}
                      class="text-accent hover:underline"
                    >
                      {p.telefono}
                    </a>
                  </td>
                  <td class="max-w-xs px-4 py-3 text-slate-300">{p.direccion}</td>
                  <td class="max-w-sm px-4 py-3 text-slate-200">{p.producto}</td>
                  <td class="px-4 py-3 text-center">
                    <span class="inline-flex min-w-[2rem] items-center justify-center rounded-full bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent">
                      {p.cantidad}
                    </span>
                  </td>
                  <td class="max-w-xs px-4 py-3 text-slate-400">
                    {p.notas ?? <span class="italic text-slate-600">—</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </main>
</Layout>
