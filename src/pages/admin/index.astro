---
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { getSession } from '../../lib/auth';
import { listPedidos, type Pedido } from '../../lib/db';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/login');
}

let pedidos: Pedido[] = [];
let loadError: string | null = null;

try {
  pedidos = await listPedidos();
} catch (err) {
  loadError = err instanceof Error ? err.message : 'No se pudieron cargar los pedidos.';
}

const formatDate = (iso: string): string => {
  const date = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
  if (Number.isNaN(date.getTime())) return iso;
  return new Intl.DateTimeFormat('es-PE', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'America/Lima',
  }).format(date);
};
---

<Layout title="Admin · Pedidos">
  <header class="sticky top-0 z-30 border-b border-border bg-background/85 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 py-4 sm:gap-4 sm:px-6 lg:px-8">
      <div class="flex min-w-0 items-center gap-3">
        <a href="/" class="flex items-center text-sm text-muted transition hover:text-accent" aria-label="Volver al catálogo" title="Volver">
          <span aria-hidden="true">←</span>
          <span class="ml-1 hidden sm:inline">Volver al catálogo</span>
        </a>
        <span class="hidden text-border sm:inline">·</span>
        <h1 class="truncate font-display text-lg font-bold text-ink sm:text-xl">
          Pedidos
        </h1>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <ThemeToggle />
        <span class="hidden text-xs text-muted lg:inline">
          Sesión: <strong class="text-ink">{session.u}</strong>
        </span>
        <form action="/api/auth/logout" method="POST">
          <button
            type="submit"
            class="btn-secondary inline-flex items-center gap-1.5 p-2 text-sm sm:px-4 sm:py-2"
            aria-label="Cerrar sesión"
            title="Cerrar sesión"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span class="hidden sm:inline">Cerrar sesión</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-bold text-ink">Pedidos recibidos</h2>
        <p class="mt-1 text-sm text-muted">
          {pedidos.length} {pedidos.length === 1 ? 'pedido' : 'pedidos'} en la base de datos
        </p>
      </div>
    </div>

    {loadError && (
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-300">
        {loadError}
      </div>
    )}

    {pedidos.length === 0 && !loadError ? (
      <div class="rounded-2xl border border-dashed border-borderStrong bg-surfaceAlt/60 py-16 text-center">
        <p class="text-3xl">📭</p>
        <p class="mt-3 text-inkSoft">Aún no hay pedidos registrados.</p>
        <p class="mt-1 text-sm text-muted">
          Cuando los clientes envíen el formulario, aparecerán aquí.
        </p>
      </div>
    ) : (
      <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-card">
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="bg-surfaceAlt text-xs uppercase tracking-wider text-blueRibbon-700 dark:text-blueRibbon-400">
              <tr>
                <th class="px-4 py-3">#</th>
                <th class="px-4 py-3">Fecha</th>
                <th class="px-4 py-3">Cliente</th>
                <th class="px-4 py-3">Teléfono</th>
                <th class="px-4 py-3">Dirección</th>
                <th class="px-4 py-3">Producto(s)</th>
                <th class="px-4 py-3 text-center">Cant.</th>
                <th class="px-4 py-3">Notas</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {pedidos.map((p) => (
                <tr class="text-inkSoft transition hover:bg-surfaceAlt/60">
                  <td class="px-4 py-3 font-mono text-xs text-muted">
                    {p.id}
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 text-muted">
                    {formatDate(p.created_at)}
                  </td>
                  <td class="px-4 py-3 font-medium text-ink">{p.nombre}</td>
                  <td class="whitespace-nowrap px-4 py-3">
                    <a
                      href={`tel:${p.telefono.replace(/\s+/g, '')}`}
                      class="text-accent hover:underline"
                    >
                      {p.telefono}
                    </a>
                  </td>
                  <td class="max-w-xs px-4 py-3 text-muted">{p.direccion}</td>
                  <td class="max-w-sm px-4 py-3 text-inkSoft">{p.producto}</td>
                  <td class="px-4 py-3 text-center">
                    <span class="inline-flex min-w-[2rem] items-center justify-center rounded-full bg-surfaceBlue px-2 py-0.5 text-xs font-bold text-blueRibbon-700 dark:text-blueRibbon-400">
                      {p.cantidad}
                    </span>
                  </td>
                  <td class="max-w-xs px-4 py-3 text-muted">
                    {p.notas ?? <span class="italic text-muted/70">—</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </main>
</Layout>
