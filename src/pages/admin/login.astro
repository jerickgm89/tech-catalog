---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';

if (getSession(Astro.cookies)) {
  return Astro.redirect('/admin');
}

const errorParam = Astro.url.searchParams.get('error');
const errorMessage =
  errorParam === 'invalid'
    ? 'Usuario o contraseña incorrectos.'
    : errorParam === 'missing'
      ? 'Ingresa usuario y contraseña.'
      : null;
---

<Layout title="Admin · Iniciar sesión">
  <main class="grid min-h-screen place-items-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="mb-6 flex items-center justify-between">
        <a href="/" class="text-sm text-slate-500 transition hover:text-accent">
          ← Volver al catálogo
        </a>
      </div>

      <div class="overflow-hidden rounded-2xl border border-blueRibbon-100 bg-white shadow-glow">
        <div class="bg-accent-gradient px-6 py-5 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-90">
            Panel admin
          </p>
          <h1 class="font-display text-2xl font-bold leading-tight text-white">
            Iniciar sesión
          </h1>
        </div>

        <form action="/api/auth/login" method="POST" class="space-y-4 px-6 py-6">
          <div>
            <label for="user" class="mb-1.5 block text-sm font-medium text-inkSoft">
              Usuario
            </label>
            <input
              type="text"
              id="user"
              name="user"
              class="input-field"
              required
              autocomplete="username"
              autofocus
            />
          </div>

          <div>
            <label for="password" class="mb-1.5 block text-sm font-medium text-inkSoft">
              Contraseña
            </label>
            <input
              type="password"
              id="password"
              name="password"
              class="input-field"
              required
              autocomplete="current-password"
            />
          </div>

          {errorMessage && (
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
              {errorMessage}
            </div>
          )}

          <button type="submit" class="btn-primary w-full">
            Ingresar
          </button>
        </form>
      </div>

      <div class="mt-6 rounded-xl border border-blueRibbon-100 bg-blueRibbon-50/60 px-4 py-3 text-center">
        <p class="text-xs uppercase tracking-wider text-blueRibbon-700">
          Credenciales de demo
        </p>
        <p class="mt-1 text-sm text-inkSoft">
          Usuario: <code class="rounded bg-white px-1.5 py-0.5 font-mono text-blueRibbon-700">admin</code>
          ·
          Contraseña: <code class="rounded bg-white px-1.5 py-0.5 font-mono text-blueRibbon-700">admin</code>
        </p>
      </div>
    </div>
  </main>
</Layout>
